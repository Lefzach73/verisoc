{
  "$defs": {
    "ActivityRecord": {
      "additionalProperties": false,
      "properties": {
        "approved_at": {
          "format": "date-time",
          "title": "Approved At",
          "type": "string"
        },
        "bindings": {
          "items": {
            "$ref": "#/$defs/EventBinding"
          },
          "maxItems": 500,
          "minItems": 1,
          "title": "Bindings",
          "type": "array"
        },
        "dataset_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Dataset Id",
          "type": "string"
        },
        "event_source_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Event Source Sha256",
          "type": "string"
        },
        "host_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Host Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "approved_password_reset",
            "approved_lab_execution"
          ],
          "title": "Kind",
          "type": "string"
        },
        "principal_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Principal Id",
          "type": "string"
        },
        "schema_version": {
          "const": "activity-1.0",
          "default": "activity-1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "status": {
          "enum": [
            "approved",
            "revoked"
          ],
          "title": "Status",
          "type": "string"
        },
        "ticket_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Ticket Id",
          "type": "string"
        },
        "valid_from": {
          "format": "date-time",
          "title": "Valid From",
          "type": "string"
        },
        "valid_until": {
          "format": "date-time",
          "title": "Valid Until",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "status",
        "ticket_id",
        "dataset_id",
        "event_source_sha256",
        "host_id",
        "principal_id",
        "approved_at",
        "valid_from",
        "valid_until",
        "bindings"
      ],
      "title": "ActivityRecord",
      "type": "object"
    },
    "ContextProof": {
      "additionalProperties": false,
      "properties": {
        "context_record_id": {
          "format": "uuid",
          "title": "Context Record Id",
          "type": "string"
        },
        "file_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "File Sha256",
          "type": "string"
        },
        "raw_row_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Raw Row Sha256",
          "type": "string"
        },
        "row_index": {
          "maximum": 1000,
          "minimum": 1,
          "title": "Row Index",
          "type": "integer"
        }
      },
      "required": [
        "file_sha256",
        "row_index",
        "raw_row_sha256",
        "context_record_id"
      ],
      "title": "ContextProof",
      "type": "object"
    },
    "EventBinding": {
      "additionalProperties": false,
      "properties": {
        "canonical_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Canonical Sha256",
          "type": "string"
        },
        "event_id": {
          "format": "uuid",
          "title": "Event Id",
          "type": "string"
        }
      },
      "required": [
        "event_id",
        "canonical_sha256"
      ],
      "title": "EventBinding",
      "type": "object"
    },
    "EvidenceHash": {
      "additionalProperties": false,
      "properties": {
        "canonical_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Canonical Sha256",
          "type": "string"
        },
        "event_id": {
          "format": "uuid",
          "title": "Event Id",
          "type": "string"
        },
        "file_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "File Sha256",
          "type": "string"
        },
        "raw_row_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Raw Row Sha256",
          "type": "string"
        },
        "row_index": {
          "maximum": 5000,
          "minimum": 1,
          "title": "Row Index",
          "type": "integer"
        }
      },
      "required": [
        "event_id",
        "canonical_sha256",
        "raw_row_sha256",
        "file_sha256",
        "row_index"
      ],
      "title": "EvidenceHash",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "activity": {
      "$ref": "#/$defs/ActivityRecord"
    },
    "case_id": {
      "format": "uuid",
      "title": "Case Id",
      "type": "string"
    },
    "dataset_id": {
      "maxLength": 256,
      "minLength": 1,
      "title": "Dataset Id",
      "type": "string"
    },
    "event_proofs": {
      "items": {
        "$ref": "#/$defs/EvidenceHash"
      },
      "maxItems": 500,
      "minItems": 1,
      "title": "Event Proofs",
      "type": "array"
    },
    "explained_fact_id": {
      "format": "uuid",
      "title": "Explained Fact Id",
      "type": "string"
    },
    "fact_id": {
      "format": "uuid",
      "title": "Fact Id",
      "type": "string"
    },
    "predicate": {
      "const": "approved_activity_recorded",
      "default": "approved_activity_recorded",
      "title": "Predicate",
      "type": "string"
    },
    "rule_version": {
      "const": "context-1.0",
      "default": "context-1.0",
      "title": "Rule Version",
      "type": "string"
    },
    "source_id": {
      "maxLength": 256,
      "minLength": 1,
      "title": "Source Id",
      "type": "string"
    },
    "source_proof": {
      "$ref": "#/$defs/ContextProof"
    },
    "tenant_id": {
      "format": "uuid",
      "title": "Tenant Id",
      "type": "string"
    }
  },
  "required": [
    "fact_id",
    "tenant_id",
    "case_id",
    "dataset_id",
    "explained_fact_id",
    "source_id",
    "activity",
    "source_proof",
    "event_proofs"
  ],
  "title": "ContextCandidate",
  "type": "object"
}
