{
  "additionalProperties": false,
  "properties": {
    "blind_to_outputs": {
      "const": true,
      "title": "Blind To Outputs",
      "type": "boolean"
    },
    "blinded_case_id": {
      "maxLength": 256,
      "minLength": 1,
      "title": "Blinded Case Id",
      "type": "string"
    },
    "cited_event_ids": {
      "items": {
        "type": "string"
      },
      "maxItems": 500,
      "minItems": 1,
      "title": "Cited Event Ids",
      "type": "array"
    },
    "human_attestation_reference": {
      "maxLength": 256,
      "minLength": 1,
      "title": "Human Attestation Reference",
      "type": "string"
    },
    "independent_of_authors": {
      "const": true,
      "title": "Independent Of Authors",
      "type": "boolean"
    },
    "label": {
      "enum": [
        "malicious",
        "benign",
        "needs_review"
      ],
      "title": "Label",
      "type": "string"
    },
    "packet_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Packet Sha256",
      "type": "string"
    },
    "rationale": {
      "maxLength": 4000,
      "minLength": 20,
      "title": "Rationale",
      "type": "string"
    },
    "reviewer_id": {
      "maxLength": 256,
      "minLength": 1,
      "title": "Reviewer Id",
      "type": "string"
    },
    "submitted_at": {
      "format": "date-time",
      "title": "Submitted At",
      "type": "string"
    }
  },
  "required": [
    "blinded_case_id",
    "reviewer_id",
    "packet_sha256",
    "label",
    "rationale",
    "cited_event_ids",
    "blind_to_outputs",
    "independent_of_authors",
    "human_attestation_reference",
    "submitted_at"
  ],
  "title": "SubmittedReview",
  "type": "object"
}
