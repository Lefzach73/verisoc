{
  "$defs": {
    "ActivityRecord": {
      "additionalProperties": false,
      "properties": {
        "approved_at": {
          "format": "date-time",
          "title": "Approved At",
          "type": "string"
        },
        "bindings": {
          "items": {
            "$ref": "#/$defs/EventBinding"
          },
          "maxItems": 500,
          "minItems": 1,
          "title": "Bindings",
          "type": "array"
        },
        "dataset_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Dataset Id",
          "type": "string"
        },
        "event_source_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Event Source Sha256",
          "type": "string"
        },
        "host_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Host Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "approved_password_reset",
            "approved_lab_execution"
          ],
          "title": "Kind",
          "type": "string"
        },
        "principal_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Principal Id",
          "type": "string"
        },
        "schema_version": {
          "const": "activity-1.0",
          "default": "activity-1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "status": {
          "enum": [
            "approved",
            "revoked"
          ],
          "title": "Status",
          "type": "string"
        },
        "ticket_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Ticket Id",
          "type": "string"
        },
        "valid_from": {
          "format": "date-time",
          "title": "Valid From",
          "type": "string"
        },
        "valid_until": {
          "format": "date-time",
          "title": "Valid Until",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "status",
        "ticket_id",
        "dataset_id",
        "event_source_sha256",
        "host_id",
        "principal_id",
        "approved_at",
        "valid_from",
        "valid_until",
        "bindings"
      ],
      "title": "ActivityRecord",
      "type": "object"
    },
    "ContextProof": {
      "additionalProperties": false,
      "properties": {
        "context_record_id": {
          "format": "uuid",
          "title": "Context Record Id",
          "type": "string"
        },
        "file_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "File Sha256",
          "type": "string"
        },
        "raw_row_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Raw Row Sha256",
          "type": "string"
        },
        "row_index": {
          "maximum": 1000,
          "minimum": 1,
          "title": "Row Index",
          "type": "integer"
        }
      },
      "required": [
        "file_sha256",
        "row_index",
        "raw_row_sha256",
        "context_record_id"
      ],
      "title": "ContextProof",
      "type": "object"
    },
    "EventBinding": {
      "additionalProperties": false,
      "properties": {
        "canonical_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Canonical Sha256",
          "type": "string"
        },
        "event_id": {
          "format": "uuid",
          "title": "Event Id",
          "type": "string"
        }
      },
      "required": [
        "event_id",
        "canonical_sha256"
      ],
      "title": "EventBinding",
      "type": "object"
    },
    "EvidenceHash": {
      "additionalProperties": false,
      "properties": {
        "canonical_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Canonical Sha256",
          "type": "string"
        },
        "event_id": {
          "format": "uuid",
          "title": "Event Id",
          "type": "string"
        },
        "file_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "File Sha256",
          "type": "string"
        },
        "raw_row_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Raw Row Sha256",
          "type": "string"
        },
        "row_index": {
          "maximum": 5000,
          "minimum": 1,
          "title": "Row Index",
          "type": "integer"
        }
      },
      "required": [
        "event_id",
        "canonical_sha256",
        "raw_row_sha256",
        "file_sha256",
        "row_index"
      ],
      "title": "EvidenceHash",
      "type": "object"
    },
    "FactView": {
      "additionalProperties": false,
      "properties": {
        "distinct_users": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Distinct Users"
        },
        "end_at": {
          "format": "date-time",
          "title": "End At",
          "type": "string"
        },
        "event_code": {
          "anyOf": [
            {
              "enum": [
                4624,
                4625,
                4688,
                3
              ],
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Event Code"
        },
        "event_count": {
          "title": "Event Count",
          "type": "integer"
        },
        "fact_id": {
          "format": "uuid",
          "title": "Fact Id",
          "type": "string"
        },
        "host_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Host Id"
        },
        "input_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Input Hash",
          "type": "string"
        },
        "predicate": {
          "enum": [
            "observed_event",
            "failed_login_burst",
            "multi_account_failures",
            "source_account_failures",
            "success_after_failures",
            "windows_image_match"
          ],
          "title": "Predicate",
          "type": "string"
        },
        "priority": {
          "enum": [
            0,
            1,
            2
          ],
          "title": "Priority",
          "type": "integer"
        },
        "rule_id": {
          "title": "Rule Id",
          "type": "string"
        },
        "rule_version": {
          "title": "Rule Version",
          "type": "string"
        },
        "source_event_ids": {
          "items": {
            "format": "uuid",
            "type": "string"
          },
          "title": "Source Event Ids",
          "type": "array"
        },
        "source_proof_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Source Proof Sha256",
          "type": "string"
        },
        "start_at": {
          "format": "date-time",
          "title": "Start At",
          "type": "string"
        },
        "user_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "User Id"
        }
      },
      "required": [
        "fact_id",
        "predicate",
        "rule_id",
        "rule_version",
        "priority",
        "start_at",
        "end_at",
        "event_count",
        "event_code",
        "distinct_users",
        "host_id",
        "user_id",
        "source_event_ids",
        "source_proof_sha256",
        "input_hash"
      ],
      "title": "FactView",
      "type": "object"
    },
    "VerifiedContext": {
      "additionalProperties": false,
      "properties": {
        "activity": {
          "$ref": "#/$defs/ActivityRecord"
        },
        "case_id": {
          "format": "uuid",
          "title": "Case Id",
          "type": "string"
        },
        "dataset_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Dataset Id",
          "type": "string"
        },
        "event_proofs": {
          "items": {
            "$ref": "#/$defs/EvidenceHash"
          },
          "maxItems": 500,
          "minItems": 1,
          "title": "Event Proofs",
          "type": "array"
        },
        "explained_fact_id": {
          "format": "uuid",
          "title": "Explained Fact Id",
          "type": "string"
        },
        "fact_id": {
          "format": "uuid",
          "title": "Fact Id",
          "type": "string"
        },
        "predicate": {
          "const": "approved_activity_recorded",
          "default": "approved_activity_recorded",
          "title": "Predicate",
          "type": "string"
        },
        "rule_version": {
          "const": "context-1.0",
          "default": "context-1.0",
          "title": "Rule Version",
          "type": "string"
        },
        "source_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Source Id",
          "type": "string"
        },
        "source_proof": {
          "$ref": "#/$defs/ContextProof"
        },
        "tenant_id": {
          "format": "uuid",
          "title": "Tenant Id",
          "type": "string"
        },
        "verification_status": {
          "const": "verified",
          "default": "verified",
          "title": "Verification Status",
          "type": "string"
        }
      },
      "required": [
        "fact_id",
        "tenant_id",
        "case_id",
        "dataset_id",
        "explained_fact_id",
        "source_id",
        "activity",
        "source_proof",
        "event_proofs"
      ],
      "title": "VerifiedContext",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "case_id": {
      "format": "uuid",
      "title": "Case Id",
      "type": "string"
    },
    "disposition": {
      "enum": [
        "suspicious",
        "explained_activity",
        "observation_only",
        "review_required"
      ],
      "title": "Disposition",
      "type": "string"
    },
    "incident_verdict": {
      "const": "needs_review",
      "default": "needs_review",
      "title": "Incident Verdict",
      "type": "string"
    },
    "indicator_evidence": {
      "default": [],
      "items": {
        "$ref": "#/$defs/FactView"
      },
      "title": "Indicator Evidence",
      "type": "array"
    },
    "limitation": {
      "default": "Recorded authorization is context, not proof of benign intent or source truth.",
      "title": "Limitation",
      "type": "string"
    },
    "missing_fields": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Missing Fields",
      "type": "array"
    },
    "omitted_indicator_ids": {
      "default": [],
      "items": {
        "format": "uuid",
        "type": "string"
      },
      "title": "Omitted Indicator Ids",
      "type": "array"
    },
    "pipeline": {
      "const": "B3-hybrid-v0.5",
      "default": "B3-hybrid-v0.5",
      "title": "Pipeline",
      "type": "string"
    },
    "reason_codes": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Reason Codes",
      "type": "array"
    },
    "selected_fact_ids": {
      "default": [],
      "items": {
        "format": "uuid",
        "type": "string"
      },
      "title": "Selected Fact Ids",
      "type": "array"
    },
    "tenant_id": {
      "format": "uuid",
      "title": "Tenant Id",
      "type": "string"
    },
    "triage_flag": {
      "default": false,
      "title": "Triage Flag",
      "type": "boolean"
    },
    "unexplained_indicator_ids": {
      "default": [],
      "items": {
        "format": "uuid",
        "type": "string"
      },
      "title": "Unexplained Indicator Ids",
      "type": "array"
    },
    "verified_context": {
      "default": [],
      "items": {
        "$ref": "#/$defs/VerifiedContext"
      },
      "title": "Verified Context",
      "type": "array"
    },
    "verified_observations": {
      "default": [],
      "items": {
        "$ref": "#/$defs/FactView"
      },
      "title": "Verified Observations",
      "type": "array"
    }
  },
  "required": [
    "case_id",
    "tenant_id",
    "disposition"
  ],
  "title": "TriageReport",
  "type": "object"
}
