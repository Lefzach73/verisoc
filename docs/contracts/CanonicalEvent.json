{
  "$defs": {
    "Attributes": {
      "additionalProperties": false,
      "properties": {
        "event_code": {
          "enum": [
            4624,
            4625,
            4688,
            3
          ],
          "title": "Event Code",
          "type": "integer"
        },
        "message": {
          "default": "",
          "maxLength": 2048,
          "title": "Message",
          "type": "string"
        }
      },
      "required": [
        "event_code"
      ],
      "title": "Attributes",
      "type": "object"
    },
    "SourceRef": {
      "additionalProperties": false,
      "properties": {
        "file_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "File Sha256",
          "type": "string"
        },
        "raw_row_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Raw Row Sha256",
          "type": "string"
        },
        "row_index": {
          "maximum": 5000,
          "minimum": 1,
          "title": "Row Index",
          "type": "integer"
        }
      },
      "required": [
        "file_sha256",
        "row_index",
        "raw_row_sha256"
      ],
      "title": "SourceRef",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "attributes": {
      "$ref": "#/$defs/Attributes"
    },
    "canonical_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Canonical Sha256",
      "type": "string"
    },
    "dataset_id": {
      "maxLength": 256,
      "minLength": 1,
      "title": "Dataset Id",
      "type": "string"
    },
    "dst_ip": {
      "anyOf": [
        {
          "format": "ipvanyaddress",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Dst Ip"
    },
    "dst_port": {
      "anyOf": [
        {
          "maximum": 65535,
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Dst Port"
    },
    "event_action": {
      "enum": [
        "login",
        "process_start",
        "connect"
      ],
      "title": "Event Action",
      "type": "string"
    },
    "event_id": {
      "format": "uuid",
      "title": "Event Id",
      "type": "string"
    },
    "host_id": {
      "anyOf": [
        {
          "maxLength": 256,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Host Id"
    },
    "ingested_at": {
      "format": "date-time",
      "title": "Ingested At",
      "type": "string"
    },
    "occurred_at": {
      "format": "date-time",
      "title": "Occurred At",
      "type": "string"
    },
    "outcome": {
      "enum": [
        "success",
        "failure",
        "unknown"
      ],
      "title": "Outcome",
      "type": "string"
    },
    "process_name": {
      "anyOf": [
        {
          "maxLength": 256,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Process Name"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "source_kind": {
      "enum": [
        "windows_auth",
        "windows_process",
        "network_flow"
      ],
      "title": "Source Kind",
      "type": "string"
    },
    "source_ref": {
      "$ref": "#/$defs/SourceRef"
    },
    "src_ip": {
      "anyOf": [
        {
          "format": "ipvanyaddress",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Src Ip"
    },
    "src_port": {
      "anyOf": [
        {
          "maximum": 65535,
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Src Port"
    },
    "tenant_id": {
      "format": "uuid",
      "title": "Tenant Id",
      "type": "string"
    },
    "user_id": {
      "anyOf": [
        {
          "maxLength": 256,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "User Id"
    }
  },
  "required": [
    "event_id",
    "tenant_id",
    "dataset_id",
    "occurred_at",
    "ingested_at",
    "source_kind",
    "event_action",
    "outcome",
    "attributes",
    "source_ref",
    "canonical_sha256"
  ],
  "title": "CanonicalEvent",
  "type": "object"
}
